# =============================================================================
# SideQuest — Server Environment Variables Template
# Copy this file to server/.env for local backend development.
# NEVER commit server/.env to version control!
#
# SECURITY ARCHITECTURE NOTICE:
# - These variables are strictly SERVER-SIDE ONLY.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend or any VITE_ variable.
# - In production, inject these variables via your cloud host secret manager.
# =============================================================================

# Server runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server port to bind
PORT=4000

# Frontend origins allowed by CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase project dashboard: Settings -> API
# -----------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co or http://127.0.0.1:54321 for local)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public/anon key used for standard user token verification
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Privileged service_role secret key (OPTIONAL in Phase 3A, required in later phases
# for trusted background operations like XP awarding, AI verification, and cron maintenance).
# WARNING: Bypasses Row Level Security! Keep strictly confidential on the server.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
