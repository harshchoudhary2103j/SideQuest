{
  "name": "sidequest-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:verify": "tsx src/scripts/verifyDatabase.ts",
    "db:seed": "tsx src/scripts/seedDatabase.ts",
    "db:test": "tsx src/scripts/runSecurityTests.ts",
    "test:phase3b": "tsx src/scripts/testPhase3B.ts",
    "test:phase4a": "tsx src/scripts/testPhase4A.ts",
    "test:phase4b": "tsx src/scripts/testPhase4B.ts",
    "test:phase4c": "tsx src/scripts/testPhase4C.ts"
