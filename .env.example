# SideQuest — Frontend Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# Only variables prefixed with VITE_ are exposed to the client browser.
# DO NOT place Supabase service_role keys or secrets here!

# -----------------------------------------------------------------------------
# Supabase Public Configuration
# Obtain these from your Supabase project dashboard: Settings -> API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# -----------------------------------------------------------------------------
# Optional API Proxy / Backend URL (used when connecting to the Express API)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
